			  //document.images[254].src=clear_lb.src;
			  //f[254]=1;
			  //document.images[255].src=clear_rb.src;
			  //f[255]=1;
			  }
		}
		
		public function newgame(first:Boolean):void {
			
			var s,i;
			five[1]=0;
			s=1;
			
			for(i=0;i<256;i++) {
			  if(f[s-1]||first) {
				  /*if ((s-1)%16 == 0)
				  {
					if ((s-1)/16 == 0)
					  //document.images[s-1].src=emp_lt.src;
					else if ((s-1)/16 == 15)
					  //document.images[s-1].src=emp_lb.src;
					else
					  //document.images[s-1].src=emp_l.src;
				  }
				  else if ((s-1)%16 == 15)
				  {
					if ((s-1)/16 < 1)
					  //document.images[s-1].src=emp_rt.src;
					else if ((s-1)/16 >= 15)
					  //document.images[s-1].src=emp_rb.src;
					else
					  //document.images[s-1].src=emp_r.src;
				  }
				  else
				  {
					if ((s-1)/16 < 1)
					  //document.images[s-1].src=emp_t.src;
					else if ((s-1)/16 >= 15)
					  //document.images[s-1].src=emp_b.src;
					else
					  //document.images[s-1].src=emp.src;
				  }*/
				f[s-1]=0;
				}
			  s=s*180%257;
			  }
			   //s=s*180%257; //?
			}
			
			
			public function ai():void {
				
				var d,ofs,z,c2;
				think();
				checkwin();
				
				if(five[1]==0) {
						
					// set ai move
					
					var __x:int, __y:int;
					
					__x = Math.floor(best/boardSize);
					__y = best%boardSize;
					
					
					s.debugTrace("AI move: "+__x+":"+__y+" ("+best+")");
					currentTurn = 2;
					selectSquare(__x, __y);
					
					//currentTurn = (currentTurn == 0)?(1):(0);
					
					
					//document.images[best].src=p2.src;
					f[best]=2;
					currentBoard[__x][__y] = currentTurn;
				
					for(d=0;d<4;d++)
					  for(ofs=-4;ofs<=0;ofs++)
						if((best/16+ofs>=0 && best/16+ofs<12 || d==0)
						  &&(best%16+ofs>=0 && best%16+ofs<12 || d==1 || d ==2)
						  &&(best%16-ofs>=4 && best%16-ofs<16 || d!=2)) {
						  	c2=0;
						  for(z=0;z<5;z++)
							if(f[best+(z+ofs)*da[d]]==2)
							  c2++;
						  if(c2==5)
							for(z=0;z<5;z++)
							  five[z]=best+(z+ofs)*da[d];
					}
				checkwin();
			}
				
		}
	}
