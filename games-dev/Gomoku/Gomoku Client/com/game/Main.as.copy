		public function createBoard():void {
			
		}
		
		public function resetBoard():void {
			for(var i=0; i<boardSize; i++) {

				currentBoard[i] = new Array();
				
				for(var j=0; j<boardSize; j++) {
					//trace(j);
					currentBoard[i][j] = 0;
					(board.getChildAt(i*boardSize + j)as MovieClip).gotoAndStop(1);
					//(board.getChildByName("square_"+i+"_"+j) as MovieClip).gotoAndStop(1);
				}
			}
				
		}
		
		public function isPlayerTurn():Boolean {
			s.debugTrace( (myPlayerID == currentTurn) ? "It's your turn" : "It's your opponent's turn" );
			return (myPlayerID == currentTurn)?(true):(false);
		}
		
		public function showTurn():void {
			
			menu.player1img.visible = false;
			menu.player2img.visible = false;
			
			menu["player"+currentTurn+"img"].visible = true;
			current_turn_img.gotoAndStop( isPlayerTurn()?(1):(2));
		}

		
		public function selectSquare( __i:int, __j:int ):void {
			
			//trace("Array "+ currentBoard[__i][__j]);
			if( currentBoard[__i][__j] == 0 ) {
				currentBoard[__i][__j] = currentTurn;
				(board.getChildAt(__i*boardSize + __j)as MovieClip).gotoAndStop(currentTurn+1);
				var obj:Object = {}; obj.x = __i; obj.y = __j;
				
				//s.sfs.sendXtMessage(extensionName, "move", obj)
				//changeTurn();				
				
				f[__i*boardSize + __j]=1;
				
				ai();
				//go(__i*boardSize + __j);
				
				
			}
		}
	
		public function connect():void {
			showConnectingAlert();
			s.connect();
		}
		
		public function showConnectingAlert():void {
			alert.gotoAndStop("Connect");
			alert.alpha = 0;
			alert.visible = true;
			alert.x = stage.stageWidth/2;
			alert.y = stage.stageHeight/2;
			setAlpha( alert, 0, 1 );
			stage.addChild( alert );
		}
		
		public function waitingForOpponent():void {
			alert.alpha = 1;
			alert.gotoAndStop("Opponent");
			button_back.addEventListener( MouseEvent.CLICK, backButtonEventLogout );
			/*button_back.x = (alert.width/2)-60;
			button_back.y = -(alert.height/2)+60;*/
			button_back.x = (alert.width/3);
			button_back.y = -95;
			alert.addChild( button_back );
		}
		
		public function creationRoomCompleated():void {
			setAlpha( alert, 1, 0 );
			resetBoard();
			showElement( board );
			board.addEventListener( MouseEvent.CLICK, boardClickEvent );
		}
		
		public function setAgainButton():void {
			button_again.y = (stage.stageHeight/2)-180;
			button_again.addEventListener( MouseEvent.CLICK, playAgainEvent );
			alert.addChild(button_again);
		}
		
		/**
		 * Initialize the game
		 */
		public function initGame(params:Object = null):void
		{
			if (params != null)
			{
				container = params.container;
				gameStarted = false;
				
				// Register to SmartFox events
				s.sfs = params.sfs;
				s.sfs.addEventListener(SFSEvent.onExtensionResponse, s.onExtensionResponse);
			
				// Setup my properties
				myPlayerID = s.sfs.playerId;
				
				// Show "wait" message
				waitingForOpponent();
				
				// Tell extension I'm ready to play
				s.debugTrace("Ready!");
				s.sfs.sendXtMessage(extensionName, "ready", null);
			}
		}
		
		/**
		 * Destroy the game instance
		 */
		public function destroyGame(params:Object = null):void
		{
			s.sfs.removeEventListener(SFSEvent.onExtensionResponse, s.onExtensionResponse);
			alert.gotoAndStop("Disconnect");
			//sfs.removeEventListener(SFSEvent.onSpectatorSwitched, onSpectatorSwitched)
		}
		
		/**
		 * Start the game
		 */
		public function startGame(params:Object):void
		{
			currentTurn = params.t;
			player1Id = params.p1i;
			player2Id = params.p2i;
			player1Name = params.p1n;
			player2Name = params.p2n;
			
			resetBoard();
			board.addEventListener( MouseEvent.CLICK, boardClickEvent );
			
			menu.player1txt.text = player1Name;
			menu.player2txt.text = player2Name;
			
			showTurn();
			gameStarted = true;
			s.debugTrace("Start game!");
			creationRoomCompleated();
			current_turn_img.visible = true;
		}
		
		/* * * * * *  		A N I M A T I O N S 	* * * * * */
		
		//some problems with tween by y - disappered mc...
		public function hideElement( mc:Object ):void {
			var start_y:Number = mc.y;
			var end_y:Number = mc.y-stage.stageHeight;
			mc.y = end_y;
			//var myTween:Tween = new Tween(mc, "y", Strong.easeOut, start_y, end_y, 5, true);
			var myTweenHideAlpha:Tween = new Tween(mc, "alpha", Strong.easeOut, 1, 0, 1, true);
			//myTween2.addEventListener(TweenEvent.MOTION_FINISH, function(e:Event){ mc.visible = false; trace("HIDE"); myTween.removeEventListener(TweenEvent.MOTION_FINISH, function(e:Event){});});
			
		}
		public function showElement( mc:Object ):void {
			var start_y:Number = stage.stageHeight*3/2;
			var end_y:Number = stage.stageHeight/2;
			mc.visible = true;
			mc.y = end_y;
			//var myTween:Tween = new Tween(mc, "y", Strong.easeOut, start_y, end_y, 2, true);
			var myTweenShowAlpha:Tween = new Tween(mc, "alpha", Strong.easeOut, 0, 1, 1, true);
			//myTween2.addEventListener(TweenEvent.MOTION_FINISH, function(e:Event){ mc.visible = true; mc.alpha = 1; trace("SHOW"); myTween2.removeEventListener(TweenEvent.MOTION_FINISH, function(e:Event){});});
			
		}
		public function setAlpha( mc:Object, __start:Number, __end:Number ):void {
			var myTween:Tween = new Tween(mc, "alpha", Strong.easeOut, __start, __end, 2, true);
			
				(__end == 0 )?( myTween.addEventListener(TweenEvent.MOTION_FINISH, function(e:Event){ mc.visible = false; }) ):( mc.visible = true);
		}

		/* * * * * *  		L I S T E N E R S   	* * * * * */
		
		public function menuClickEvent( e:MouseEvent ):void {
			
			mainMenu.removeEventListener( MouseEvent.CLICK, menuClickEvent );
			switch(e.target.parent.name) {
				case "button_play":
					//stage.removeChild( mainMenu );
					hideElement( mainMenu );
					connect();
					button_again.visible = false;
					break;
				case "button_settings":
					button_save.addEventListener( MouseEvent.CLICK, saveSettingsEvent );
					button_default.addEventListener( MouseEvent.CLICK, setDefaultSettingsEvent );
					hideElement( mainMenu );
					
					if(s.getSharedObject().data.nick != undefined ) {
						sboard.input_name.text = s.getSharedObject().data.nick;
						sboard.input_server.text = s.getSharedObject().data.ip+":"+s.getSharedObject().data.port;
					}
					showElement( sboard );
					
					break;
				case "button_exit":
					// Native Application!
					//NativeApplication.nativeApplication.exit();
					
					if( s.sfs.isConnected )
						s.sfs.disconnect();
					s.debugTrace("Exit!");
					break;
				default:
			}
		}
		
		public function boardClickEvent( e:MouseEvent ):void {

			trace(String(e.target.name));
			if( isPlayerTurn() ) {
				if( String(e.target.name).search("square") != -1) {
					//var str:String = String(e.target.name);
					var temp:Array = String(e.target.name).split("_");
					selectSquare( int(temp[1]), int(temp[2]) );
					
				}
			}
		}
		
		public function playAgainEvent( e:MouseEvent ):void {
			button_again.removeEventListener( MouseEvent.CLICK, playAgainEvent );
			alert.removeChild( button_again );

			waitingForOpponent();
			s.restartGame();
			
		}
		
		public function saveSettingsEvent( e:MouseEvent ):void {
			trace("Saving settings...");
			button_save.removeEventListener( MouseEvent.CLICK, saveSettingsEvent );
			button_default.removeEventListener( MouseEvent.CLICK, setDefaultSettingsEvent );
			
			playerName = sboard.input_name.text;
			var str:String = sboard.input_server.text;
			var ip:String;
			var pt:int;
			if( str.length > 0 ) {
				ip = str.substr(0, str.lastIndexOf(":"));
				pt = int(str.substr(str.lastIndexOf(":")+1, str.length-1));
			} else {
				ip = "";
				pt = 0;
			}
			s.setSharedObject(playerName, ip, pt, s.sfs.defaultZone);
			
			trace(playerName);
			if( s.sfs.isConnected )
				s.sfs.disconnect();
			
			backToMenu();
		}
		
		public function setDefaultSettingsEvent( e:MouseEvent ):void {
			
			button_save.removeEventListener( MouseEvent.CLICK, saveSettingsEvent );
			button_default.removeEventListener( MouseEvent.CLICK, setDefaultSettingsEvent );
			
			s.removeSharedObject();
			sboard.input_name.text = "";
			sboard.input_server.text = "91.121.73.217:9339";
			
			if( s.sfs.isConnected )
				s.sfs.disconnect();
			
			backToMenu();
		}
		
		
		public function backButtonEvent( e:MouseEvent ):void {
			button_save.removeEventListener( MouseEvent.CLICK, saveSettingsEvent );
			backToMenu();
		}
		
		public function backButtonEventLogout( e:MouseEvent ):void {
			//button_save.removeEventListener( MouseEvent.CLICK, saveSettingsEvent );
			//s.sfs.leaveRoom(s.sfs.getActiveRoom().getId());
			try{
				s.sfs.logout();
			}catch(e:Error){};
			
			hideElement( alert );
			alert.removeChild(button_back);
			backToMenu(false);
		}
		
		public function backToMenu( settings:Boolean = true):void {
			if(settings) {
				sboard.visible = true;
				hideElement( sboard );
			}
			showElement( mainMenu );
			mainMenu.addEventListener( MouseEvent.CLICK, menuClickEvent );
			current_turn_img.visible = false;
		}
		
		
		
		
		
		
		
		/* AI */
		public function think():void {
			
			
			var a0,a,d,h,n,p,z;
			best=0;
			n=0;
			
			for(p=0;p<3;p++)
				for(a0=0;a0<256;a0++){
					q[p][a0]=0;
					m[p][a0]=0;
				}
			for(a0=0;a0<256;a0++){
				for(d=0;d<4;d++)
					if((a0/16<12||d==0)&&(a0%16<12||d==1||d==2)&&(a0%16>3||d!=2)){
						
						c[1]=0;
						c[2]=0;
						
						for(z=0;z<5;z++)
							c[f[a0+z*da[d]]]++;
						
						if(!c[1])
							p=2;
						else if(!c[2])
							p=1;
						else 
							p=0;
						
						if(p)
							for(z=0;z<5;z++){
								
								if(c[p]==5)
									five[z]=a0+z*da[d];
								else if(f[a0+z*da[d]]==0){
									a=a0+z*da[d];
									q[0][a]+=e[c[p]];
									
									if(c[p]>=2)
										q[p][a]+=e[c[p]];
									if(c[p]>m[p][a])
										m[p][a]=c[p];
								}
							}
						}
						
					for(p=1;p<3;p++)
						if(q[p][a0]>=e[4]){
						
							h=2*m[p][a0];
							if(p==2)
								h++;
							
							if(q[0][a0]<256)
								q[0][a0]+=256*h;
							else if(q[0][a0]<256*h)
								q[0][a0]=256*h;
						}
					if(q[0][a0]>q[0][best])
						n=0;
					if(q[0][a0]>=q[0][best]){
						n++;
						if(Math.random()*n<1)
							best=a0;
					}
			}
		}
			
