		public function createSquares():void {
			
			for(var i=0; i<boardSize; i++) {
				for(var j=0; j<boardSize; j++) {
					var s:Square = new Square();
					s.name = "square_"+i+"_"+j;
					s.gotoAndStop(1);
					s.x = -408+(i*36.7);
					s.y = -258+(j*36.7);
					this.board.addChild(s);
				}
			}
		}
		
		public function setTitle( __obj:Object, __name:String ):void {
			__obj.b_title.text = __name;
			__obj.name = String( "button_"+__name.toLowerCase() );
		}
		
