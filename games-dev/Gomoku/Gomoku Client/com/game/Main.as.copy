				if(f[five[z]]==1)
				  //document.images[five[z]].src=win1.src;
				  trace("WIN1 AI");
				else
				  //document.images[five[z]].src=win2.src;
				  trace("WIN2");
				}
			  //document.images[238].src=clear_lt.src;
