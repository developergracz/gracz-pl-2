		/**
		 * Handle the opponent move
		 */
		//public function moveReceived(turn:int, __x:int, __y:int, __x2:int, __y2:int, __p:int):void
		public function moveReceived(turn:int, movesObj:SFSObject):void
		{
			//var movingPlayer:int = params.getInt("t")
			trace("moveReceived");
			//whoseTurn = (turn == 1) ? 2 : 1
			
			var temp:ISFSObject;
			for(var i:int = 0; i<movesObj.size(); i++){
				
				temp = movesObj.getSFSObject( i.toString() );
				
				
				var __x:int = temp.getInt("x1");
				var __y:int = temp.getInt("y1");
				var __p:int = temp.getInt("p1");
				
				var __x2:int = temp.getInt("x2");
				var __y2:int = temp.getInt("y2");
				var __p2:int = temp.getInt("p2");
				
				trace("New move: "+__x+":"+__y+" -> "+__x2+":"+__y2+" ("+__p2+")");
				
				// SOUND
				if(opt_box.acceptSound()){
					mySound.play();
				}
				
				var __rx:int = -1;
				var __ry:int = -1;
				var __rp:int = -1;
				
				
				if(temp.containsKey("rx")){
					var removed_piece:Piece = getPiece( temp.getInt("rx"), temp.getInt("ry"), true );
					removePiece( removed_piece );
					__rx = temp.getInt("rx");
					__ry = temp.getInt("ry");
					__rp = temp.getInt("rp");
				}
				
				selectSquare(__x, __y, __x2, __y2, __p2);
				if(s.s.amIPlayer()) {
					//hist.addMove( __x, __y, false);
					hist.addMove( __x,__y,__p,  __x2,__y2,__p2,  __rx,__ry,__rp, false);
				}else {
					//hist.addMove( __x, __y, false, firstPlayer==1?turn:((turn == 1)?2:1)); //s.g.firstPlayer==1?boardRow[2]:((boardRow[2] == 1)?2:1)
					hist.addMove( __x,__y,__p, __x2,__y2,__p2, __rx,__ry,__rp, false, s.g.firstPlayer==1?turn:((turn == 1)?2:1));
					//hist.addMove( __x,__y,__p, __x2,__y2,__p2, __rx,__ry,__rp, false, s.g.firstPlayer==1?((__p==4 || __p==8)?(1):(2)):((__p==2 || __p==6)?(1):(2)));
				}
				
				//if(removed_piece != null){
					//removePiece( removed_piece );
				//}
				
				/*if(__p == 6 || __p == 8){
												
					trace("New Queeen!");
					var p:Piece = getPiece(__x2, __y2).setQueen();
					
					//board[__x][__y] = __p;//p.piece_color;//cur_col+4;
				}*/
			}
			
			
			// set queen
			/*var __x:int = temp.getInt("x2");
			var __y:int = temp.getInt("y2");
			var __p:int = temp.getInt("p2");
			
			//if( __x == ((__p == 2)?(boardSize-1):(0)) ){
				if(__p == 6 || __p == 8){
												
					trace("New Queeen!");
					var p:Piece = getPiece(__x, __y).setQueen();
					
					board[__x][__y] = __p;//p.piece_color;//cur_col+4;
				}*/
			//}
			
			check4fix();
			
			if(temp.getBool("changeTurn")) {
				currentTurn = currentTurn == 1?2:1;
				stats.changeTurn();	
			}
			
			
			//checkInterval = setInterval (check4fix, 200);
			check4fix();
			addOpt.resetLastUndo();
		}
		

	}
}