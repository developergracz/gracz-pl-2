					//jumps_length_array = [];
				//}
				var moves_array:Array = [];
				
				for (i = 0; i < piece_array.length; i++){
					a_piece = piece_array[i];
					if ((cur_col == a_piece.piece_color ||cur_col+4 == a_piece.piece_color) && (a_piece.removed == false)){
						tree.push(a_piece);
					};
				};
				
				//test all for jumps
				for (i = 0; i < tree.length; i++){
				//	if (jumps_this_turn == false){
						tmp = test_for_jumps(tree[i]);
						//isBeatAvailable(tree[i] as Piece);
