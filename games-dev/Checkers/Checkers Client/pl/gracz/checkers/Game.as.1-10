		public function Game(scene:*):void {
			s = scene;
			addOpt = new AdditionalOptions(s);
			stats = new Stats(s);
			drawBackground();
			
			
			this.addEventListener(KeyboardEvent.KEY_DOWN, traceBoard);
			this.addEventListener(MouseEvent.MOUSE_DOWN, mouseEventDown);
			this.addEventListener(MouseEvent.MOUSE_UP, mouseEventUp);
			
		}
		
		
