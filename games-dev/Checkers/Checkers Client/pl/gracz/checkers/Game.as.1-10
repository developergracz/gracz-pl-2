		public function createSelectedSquare(__x:int, __y:int):void {
			var selectedSquare:SelectedSquare = new SelectedSquare();
			selectedSquare.x = __x; 
			selectedSquare.y = __y;
			lastMoveLane.addChild(selectedSquare);
		}
		
		public function createSelectedSquareByPos(__x:int, __y:int):void {
			var selectedSquare:SelectedSquare = new SelectedSquare();
			//p.x =  15 -391 + (__j2*pieceSize*2);
			//p.y =  20 -242 + (__i2*pieceSize*2);
			selectedSquare.x = 15 -391 + (__y*pieceSize*2);
			selectedSquare.y = 20 -242 + (__x*pieceSize*2);
			lastMoveLane.addChild(selectedSquare);
			
		}
		
		public function clearSelectedSquare():void {
			
			try{
				lastMoveLane.removeChildAt(0); lastMoveLane.removeChildAt(0);
			}catch(e:Error){};
		}
		
