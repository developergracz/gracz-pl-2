						//trace ("tree i is a true jump : "+tree[i]);
						jumps_array.push(tree[i]);
						jumps_this_turn = true;
						trace("Jump on "+(tree[i] as Piece).current_row+":"+(tree[i] as Piece).current_col);
				//		break;
					}
				};
				trace ("jumps_this_turn :"+jumps_this_turn+" ("+jumps_array.length+")");
				
				/*if(jumps_this_turn && jumps_array.length > 1 && checkLength) {
					for(i=0; i<jumps_array.length; i++){
						jumps_length_array.push(0);
						var p:Piece = jumps_array[i] as Piece;
						
						moves_array = get_legal_moves(p);
						for(var j:int=0; j<moves_array.length; j++){
							trace(i+": "+moves_array[j]);
							jumps_this_turn = true;
							getLongestMove(p, i);
							//trace("Length: "+moves_array[moves_array.length-1]);
							
						}
						trace("Length ["+i+"] :"+jumps_length_array[i]);
					}

				}*/
		};
