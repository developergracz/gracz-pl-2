		public function createSquares():void {
			
			
			cont = s.board as MovieClip;
			board = makeCheckerPieces(boardSize, boardSize);
			//trace(board);
			
			cont.addChild(lastMoveLane);	
			
			for(var i=0; i<boardSize; i++) {
				for(var j=0; j<boardSize; j++) {
					
					var sq:Square = new Square(j,i);
					//((i+j)%2 == 0)?(1):(2);
					sq.gotoAndStop(1);
					sq.x = 15 -391 + (i*pieceSize*2);
					sq.y = 20 -242 + (j*pieceSize*2);
					sq.scaleX = 1.1;
					sq.scaleY = 1.1;
					//s.board.addChild(sq);
					cont.addChild(sq);
				}
			}
			
			for(var i=0; i<boardSize; i++) {
				var temp_row = board[i];
				for(var j=0; j<boardSize; j++) {
					
					if(temp_row[j] == 2 || temp_row[j] == 4) {
						var p:Piece = new Piece(i,j,(temp_row[j] == 2)?("WHITE"):("RED"));
						p.x =  15 -391 + (j*pieceSize*2);
						p.y =  20 -242 + (i*pieceSize*2);
						p.scaleX = 1;
						p.scaleY = 1;
						p.setColor(temp_row[j]);
						cont.addChild(p);
							
						p.addEventListener(MouseEvent.MOUSE_DOWN, onPieceDown);
						this.addEventListener(MouseEvent.MOUSE_UP, onPieceUp);
						piece_array.push(p);
					}
				}
			}
			
			//lastMoveLane.visible = false;
		}
		
		public function makeCheckerPieces(awidth:int,aheight:int):Array{
			var i:int; var j:int; var tmp:int;
			var val:int = 0; 
			var arr:Array = [];
			var line:Array = [];
			for ( i = 0; i < aheight; i++){
				for (j = 0; j < awidth; j++){
					tmp = val;
					if (i<3){
						tmp = 2 * val;
					} else if (awidth - i < 4){
						tmp = 4 * val;
					}
					line.push(tmp);
					val = Math.abs(val - 1);
				};
				arr.push(line);
				line = [];
				val = Math.abs(val - 1);
			}
			return arr;
		};
		
		
		public function onPieceBack(){
			
			if(movingPiece != null && movingPiece.dragging){
				
				trace("Back from "+movingPiece.x+":"+movingPiece.y+" to "+movingPiece.start_x+":"+movingPiece.start_y);
				
				movingPiece.stopDrag();
				movingPiece.x = movingPiece.start_x;
				movingPiece.y = movingPiece.start_y;
				
				
				movingPiece.setDragg(false);
				movingPiece = null;
			}
		}
		
		public function onPieceUp(e:MouseEvent){
			
			if(e.target is Piece && (e.target as Piece).dragging) {
				var arr:Array = getObjectsUnderPoint(new Point(e.stageX, e.stageY));
				//var p:Piece = movingPiece;
				var p:Piece = e.target as Piece;
				p.stopDrag();
				var cur_col:int = 2*(firstPlayer == 1?(currentTurn):((currentTurn)%2 +1));
				
				pc: {
					for each(var ob in arr){
						ob = ob.parent;
						//trace(ob);
						if(ob is Square){
							/* TODO: if object is free && is move available */
							
							for each(var r in legal_moves){
								trace("Comparing: "+r+" "+ob.srow+","+ob.scol);
								if(r[0] == ob.srow && r[1] == ob.scol && p.current_row != ob.srow && p.current_col != ob.scol) {
									
									//draw line
									//lastMoveLane.graphics.clear();
									//lastMoveLane.graphics.moveTo(p.start_x, p.start_y);
									//lastMoveLane.graphics.lineStyle(5, 0xff6600);
									//lastMoveLane.graphics.lineTo(ob.x, ob.y);
									
									//draw rectangle
									//lastMoveLane.graphics.clear();
									/*try{
										lastMoveLane.removeChildAt(0); lastMoveLane.removeChildAt(0);
									}catch(e:Error){};*/
									clearSelectedSquare();
									
									/*var selectedSquare:SelectedSquare = new SelectedSquare();
									selectedSquare.x = p.start_x; selectedSquare.y = p.start_y;
									lastMoveLane.addChild(selectedSquare);
									
									selectedSquare = new SelectedSquare();
									selectedSquare.x = ob.x; selectedSquare.y = ob.y;
									lastMoveLane.addChild(selectedSquare);*/
									createSelectedSquare(p.start_x, p.start_y);		
									createSelectedSquare(ob.x, ob.y);		
									//lastMoveLane.graphics.moveTo(p.start_x, p.start_y);
									//lastMoveLane.graphics.lineStyle(5, 0xff6600);
									//lastMoveLane.graphics.lineTo(ob.x, ob.y);
									
									// create object - ready to send: p.is_queen?(turn+4):turn, p.current_row, p.current_col, ob.srow, ob.scol, p.is_queen?(turn+4):turn;
									//trace("1");
									var sfso:SFSObject = new SFSObject();
									sfso.putInt("x1", p.current_row);
									sfso.putInt("y1", p.current_col);
									sfso.putInt("p1", p.piece_color);
									
									p.x = ob.x;
									p.y = ob.y;
									p.setDragg(false);
									
									board[p.current_row][p.current_col] = 1;
									
									
									// SOUND
									if(opt_box.acceptSound()){
										mySound.play();
									}
		
									
									//trace("2");
									var removed_piece:Piece = null;
									
									if(jumps_this_turn){
										removed_piece = searchPieceBetween(p,ob);
										trace("Removed Piece: "+removed_piece+" ("+removed_piece.current_row+":"+removed_piece.current_col);
										
										
										sfso.putInt("rx", removed_piece.current_row );
										sfso.putInt("ry", removed_piece.current_col );
										sfso.putInt("rp", removed_piece.piece_color );
										//removePiece( removed_piece );
									}else{
										trace("No jumps");
									}
									
									
									
									//x1,y1,x2,y2,piece
									//hist.addMove( p.current_row, p.current_col, ob.srow, ob.scol , true);
									hist.addMove( p.current_row,p.current_col,p.piece_color, ob.srow,ob.scol,p.piece_color, (removed_piece!=null)?removed_piece.current_row:-1,(removed_piece!=null)?removed_piece.current_col:-1, (removed_piece!=null)?removed_piece.piece_color:-1,  true);
									
									if(removed_piece != null){
										removePiece( removed_piece );
									}
				
									p.current_row = ob.srow; 
									p.current_col = ob.scol; 
									
									sfso.putInt("x2", p.current_row);
									sfso.putInt("y2", p.current_col);
									
									sfso.putInt("p2", p.piece_color);
									
									board[p.current_row][p.current_col] = p.piece_color;//p.is_queen?(cur_col+4):(cur_col);
									

									// change turn if there's no another beat
									if(!jumps_this_turn || !test_for_jumps(p) ){
										
										// check 4 change as queen
										if( p.current_row == ((cur_col == 2)?(boardSize-1):(0)) ){
											if(!p.is_queen){
												
												trace("New Queeen!");
												p.setQueen();
												board[ob.srow][ob.scol] = cur_col+4;//p.piece_color;//cur_col+4;
												sfso.removeElement("p2");
												sfso.putInt("p2", cur_col+4);//);//cur_col+4);
											}
										}
										activePiece = null;
										
										//add info about turn
										sfso.putBool("changeTurn", true);
										addOpt.enableUndo();
									

										currentTurn = currentTurn == 1?2:1;

										stats.changeTurn();	
									}else{
										//add info about turn
										sfso.putBool("changeTurn", false);
										activePiece = p;
										// add current moves
										//movesObject.putSFSObject( movesObject.size().toString(), sfso);
										addOpt.enableUndo();
									}
									
									movesObject.putSFSObject( movesObject.size().toString(), sfso);
									trace("SENDING DATA!");
									var sc:ISFSObject = new SFSObject();
									sc.putSFSObject("moves", movesObject);
									s.s.sendSFSData("move", sc);
										
									trace("Sending moves: "+sfso.getInt("x1")+":"+sfso.getInt("y1")+" ("+sfso.getInt("p1")+") -> "+sfso.getInt("x2")+":"+sfso.getInt("y2")+" ("+sfso.getInt("p2")+")");

									movesObject = new SFSObject();
										
									
									break pc;
								}								
							}

						}
					}
					
					if(p.dragging){
						p.x = p.start_x;
						p.y = p.start_y;
						p.setDragg(false);
					}
				}
				
				trace("++++++++++++++++++++++++++++++++++++\nCurrent Turn: "+(currentTurn*2));
				
			}else{
				onPieceBack();
			}
			movingPiece = null;
			
			check4fix();
		}
		
		
		public function check4fix():void {
		
			for(var i:int = 0; i<boardSize; i++){
				for(var j:int = 0; j<boardSize; j++){
					if(board[i][j] == 1){
						var p:Piece = getPiece(i,j);
						if(p != null){
							p.setRemoved();
						}
					}
				}
			}
		}
		
		public function searchPieceBetween(currentPiece:Piece, destinationSquare:Square):Piece {
			
			var move_row:int = currentPiece.current_row-destinationSquare.srow;
			var move_col:int = currentPiece.current_col-destinationSquare.scol;
			
			/*if(Math.abs(move_row) == 2 && Math.abs(move_col) == 2) {
				//get piece at
				var _row:int = (move_row > 0)?(currentPiece.current_row-1):(currentPiece.current_row+1);
				var _col:int = (move_col > 0)?(currentPiece.current_col-1):(currentPiece.current_col+1);

				return getPiece(_row, _col);
			}else{*/
				// queen
				var i:int;
				var _row_transition:int = (currentPiece.current_row > destinationSquare.srow)?(-1):(1);
				var _col_transition:int = (currentPiece.current_col > destinationSquare.scol)?(-1):(1);
				
				//trace("Row: "+_row_transition+" Col: "+_col_transition+" Length: "+Math.abs(move_row));
				for(i=1; i<Math.abs(move_row); i++){
					var c:int = currentPiece.current_col+(_col_transition*i);
					var r:int = currentPiece.current_row+(_row_transition*i);
					if( board[r][c] != 1 ){
						move_row = r;
						move_col = c;
						break;
					}
				}
				return getPiece(move_row, move_col, true);
				
			/*}
			
			return null;*/
		}
		
		
		public function getPiece(__row:int, __col:int, removed:Boolean = false):Piece {
			
			var arr:Array = new Array();
			for each(var piece in piece_array) {
				//trace((piece as Piece).current_row+" == "+__row+" && "+(piece as Piece).current_col+" == "+__col);
				if((piece as Piece).current_row == __row && (piece as Piece).current_col == __col ){//!(removed?(piece as Piece).removed:false)) {
					//trace("--pushed--");
					arr.push( (piece as Piece) );
					//return (piece as Piece);
				}
			}
			//&& !(piece as Piece).removed
			for(var i:int = 0; i<arr.length; i++){
				if((arr[i] as Piece).removed == false){
					return arr[i];
				}
			}
			return arr[0];
		}
		
		public function getRemovedPiece(__row:int, __col:int, removed:Boolean = false):Piece {
			
			var arr:Array = new Array();
			for each(var piece in piece_array) {
				if((piece as Piece).current_row == __row && (piece as Piece).current_col == __col ){//!(removed?(piece as Piece).removed:false)) {
					arr.push( (piece as Piece) );
					//return (piece as Piece);
				}
			}
			//&& !(piece as Piece).removed
			for(var i:int = 0; i<arr.length; i++){
				if((arr[i] as Piece).removed){
					return arr[i];
				}
			}
			trace("Error: Removed piece doesn't exist!");
			return null;
		}
		
		public function removePiece(p:Piece){
			
				
			board[p.current_row][p.current_col] = 1;
			trace("Remove finished: "+p+" ("+p.current_row+":"+p.current_col+")");
			p.setRemoved();		
		}
		
		
		public function unRemovePiece(__x:int, __y:int, __p:int){
			
			var p:Piece = getRemovedPiece(__x, __y);
			p.setUnRemoved(__p);
			board[p.current_row][p.current_col] = __p;
			//trace("Remove finished: "+p+" ("+p.current_row+":"+p.current_col+")");
					
		}
		
		
		public function onPieceDown(e:MouseEvent){
			
			var p:Piece = (e.currentTarget as Piece);
			
			if(p != movingPiece && (movingPiece == null || !movingPiece.dragging) && (activePiece == null || activePiece == p) ){
				get_moves();
				//trace("T: "+turn+" P: "+p.piece_color);
				var cur_col:int = 2*(firstPlayer == 1?(currentTurn):((currentTurn)%2 +1));
				//if( s.s.sfs.isConnected && s.s.isGameStarted() && isPlayerTurn() && (p.piece_color == currentTurn*2 || (p.piece_color == currentTurn*2+4)) && !p.removed ){
				if( s.s.sfs.isConnected && s.s.isGameStarted() && isPlayerTurn() && (p.piece_color == cur_col || (p.piece_color == cur_col+4)) && !p.removed ){
				
				//if ((p.piece_color == turn || (p.piece_color == turn+4)) && !p.removed ){
					
					var arr:Array = get_legal_moves(p);
					//trace("Arr: "+arr);
					if ((arr.length > 0)|| jumps_this_turn == false){
							//trace("move is good");
							//lastMoveLane.graphics.clear();
							/* BOUNDARY BOX
							p.x =  15 -391 + (j*pieceSize*2);
							p.y =  20 -242 + (i*pieceSize*2);
							*/
							
							p.startDrag(true, new Rectangle(15 -391, 20 -242, (7*2)*pieceSize, (7*2)*pieceSize)); // ADD BOUNDARY BOX!
							
							
							p.setDragg(true);
							p.set_start_x_y(p.x, p.y);
							
							movingPiece = p;
							
							// swap mc (show on top);
							var container:MovieClip = p.parent as MovieClip; 
							container.swapChildren(p, container.getChildAt(container.numChildren-2));
							//var dropShadow:DropShadowFilter = new DropShadowFilter();
							//object.filters = new Array(dropShadow);
							//hilight_moves(arr);
					};
				};
			}
		}
		
		
				
