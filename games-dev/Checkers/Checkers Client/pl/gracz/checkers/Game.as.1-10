		function get_legal_moves(an_obj:Piece):Array{ 
			var a_move:Array = [];
			var a_jump:Array = [];
			var test_row:int = 0;
			var test_col:int = 0;
			var dx:int = 0;
			var dy:int = 0;
			var row:int = an_obj.current_row;
			var col:int = an_obj.current_col;
			var i:int;
			legal_moves = [];
			
			var possible_moves:Array = [[-1,-1],[1,-1],[-1,1],[1,1]];
			var cur_col:int = 2*(firstPlayer == 1?(currentTurn):((currentTurn)%2 +1));
			
			//trace("isQueen: "+an_obj.is_queen);
			if (an_obj.piece_color == (an_obj.is_queen?(cur_col+4):(cur_col))){
				//it is this side's turn - test for moves				
				
				// add here option to switch - must beat or no?
				if( !jumps_this_turn ) {
					
					//trace("No jumps");
					if(an_obj.is_queen){
						for (i = 0; i < possible_moves.length; i++){
							a_move = possible_moves[i];
							
							
							test_row = row + a_move[0];
							test_col = col + a_move[1];
							
							if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
								continue;
							}else{
							
								while( test_row >= 0 && test_col >= 0 && test_row <= boardSize-1 && test_col <= boardSize-1 ){
									
									//trace("Test: "+test_row+ " "+test_col);
									if( board[test_row][test_col] == 1){
										legal_moves.push([test_row,test_col]);
		
										test_row += a_move[0];
										test_col += a_move[1];

									}else{
										break;
									}
								}
							}
						}
					}else{
						
						possible_moves = (cur_col == 2)?([[1,-1],[1,1]]):([[-1,-1],[-1,1]]);
						for (i = 0; i < possible_moves.length; i++){
							a_move = possible_moves[i];
							test_row = row + a_move[0];
							test_col = col + a_move[1];
							
							if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
								continue;
							}
							
							if ((board[test_row] != null) && (board[test_row][test_col] != null)){
								//tested square is valid
								if ( (board[test_row][test_col] == 1) ){
									legal_moves.push([test_row,test_col]);
								};
							}
						}
					}
				}
				// add here option to switch - must beat or no?
				if( jumps_this_turn ){
					//trace("Yep, jumps");
					if(an_obj.is_queen){
						
						for (i = 0; i < possible_moves.length; i++){
							
							//trace("Possible: "+i);
							a_move = possible_moves[i];
							
							test_row = row + a_move[0];
							test_col = col + a_move[1];
							
							if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
								
							}else{
							
								//place before
								while( board[test_row][test_col] == 1){
									
									test_row += a_move[0];
									test_col += a_move[1];
									
									if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
										break;
									}
								}
								
								//trace("test_r: "+test_row+" test_c: "+test_row);
								// enemy piece
								if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
								
								}else{
									if ( (board[test_row][test_col] != an_obj.piece_color) && (board[test_row][test_col] != an_obj.piece_color-4)){
									
										test_row += a_move[0];
										test_col += a_move[1];
										
										//trace("test_r: "+test_row+" test_c: "+test_row);
										if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
											//break;
										}else{
											//place after
											//trace("while");
											while( board[test_row][test_col] == 1){
												
												//trace("w test_r: "+test_row+" test_c: "+test_row);
												legal_moves.push([test_row,test_col]);
				
												test_row += a_move[0];
												test_col += a_move[1];
												
												if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
													break;
												}
											}
										}
									}
								}
							}
						}
					}else{
						
						possible_moves = [[-1,-1],[1,-1],[-1,1],[1,1]];
						for (i = 0; i < possible_moves.length; i++){
							a_move = possible_moves[i];
							test_row = row + a_move[0];
							test_col = col + a_move[1];
							
							if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
								;
							}else{
							
								if ( (board[test_row][test_col] != an_obj.piece_color) && (board[test_row][test_col] != an_obj.piece_color+4) && (board[test_row][test_col] != 1)){
									
									//tested square contains other side's piece - test for jump
									//a_move = possible_moves[i];
									a_move[0] += a_move[0];//a jump
									a_move[1] += a_move[1];//a jump
									test_row = row + a_move[0];
									test_col = col + a_move[1];
									
									if ((board[test_row] != null) && (board[test_row][test_col] != null)){
		
										if (board[test_row][test_col] == 1){
										// a valid jump 
											legal_moves.push([test_row,test_col]);
										};
									};
								};
							};
						};
					};
				};
			};
			trace("legal_moves :"+legal_moves);
			
			
			return legal_moves;
		};
		
		
		// add check for queen
		function test_for_jumps(an_obj:Piece):Boolean{
			//returns true if any legal moves for specified piece are jumps;
			var jump_possible:Boolean = false; 
			var a_move:Array = [];
			var test_row:int = 0;
			var test_col:int = 0;	
			var cur_col:int = 2*(firstPlayer == 1?(currentTurn):((currentTurn)%2 +1));
			
			if (an_obj.piece_color == cur_col || an_obj.piece_color == cur_col+4){
				//it is this side's turn - test for moves
				var possible_moves:Array = [[-1,-1],[1,-1],[-1,1],[1,1]];

				if(an_obj.is_queen){
					//trace("Queen");	
					for (i = 0; i < possible_moves.length; i++){
						a_move = possible_moves[i];
						test_row = an_obj.current_row + a_move[0];
						test_col = an_obj.current_col + a_move[1];
							
						if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
							continue;
						}
						
						//place before
						while( board[test_row][test_col] == 1){
							
							test_row += a_move[0];
							test_col += a_move[1];
							
							if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
								break;
							}
						}
						//trace("Looking for enemy piece: "+i+"/"+possible_moves.length);
						// enemy piece
						if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
						}else{
							trace( test_row+" "+test_col );
							if ( (board[test_row][test_col] != an_obj.piece_color) && (board[test_row][test_col] != (an_obj.piece_color-4))){
								//trace("There's enemy!");
								test_row += a_move[0];
								test_col += a_move[1];
								
								if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
									//break;
								}else{
									if( board[test_row][test_col] == 1){
											
										jump_possible = true;
										//trace("Jump possible at: "+test_row+":"+test_col);
									}else{
										//trace("No more space!");
									}
								}
							}else{
								//trace("No enemy");
							}
						};
					}
			}else{
				for (var i:int = 0; i < possible_moves.length; i++){
					a_move = possible_moves[i];
					test_row = an_obj.current_row + a_move[0];
					test_col = an_obj.current_col + a_move[1];
					
					if(test_row < 0 || test_col < 0 || test_row > boardSize-1 || test_col > boardSize-1 ){
						continue;
					}
					
					if ((board[test_row] != null) && (board[test_row][test_col] != null)){
						
						if ((board[test_row][test_col] != an_obj.piece_color) && (board[test_row][test_col] != (an_obj.piece_color+4)) && (board[test_row][test_col] != 1)){
							 //trace ("tested square contains other side's piece - test for jump");
							a_move[0] += a_move[0];//a jump
							a_move[1] += a_move[1];//a jump
							test_row = an_obj.current_row + a_move[0];
							test_col = an_obj.current_col + a_move[1];
							
							if ((board[test_row] != null) && (board[test_row][test_col] != null)){
								if (board[test_row][test_col] == 1){
									jump_possible = true;
									//trace("Jump possible at: "+test_row+":"+test_col);
								};
							};
						};
					};
				};
			};
		}
			//trace ("returning is jump possible :"+jump_possible);
			return jump_possible;
		};
		
		
		
		
