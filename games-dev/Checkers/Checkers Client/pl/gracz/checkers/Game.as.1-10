		public function hideSquares():void {
			
			for(var i=0; i<boardSize; i++) {
				
				for(var j=0; j<boardSize; j++) {
					(s.board.getChildAt(i*boardSize + j)as MovieClip).alpha = 0;
				}
			}
		}
		
		public function showSquares():void {
			
			for(var i=0; i<boardSize; i++) {
				
				for(var j=0; j<boardSize; j++) {
					(s.board.getChildAt(i*boardSize + j)as MovieClip).alpha = 1;
				}
			}
		}
		
		public function hideSquare(__x:int, __y:int):void {
			
			//(s.board.getChildAt(__x*boardSize + __y)as MovieClip).alpha = 0;
			(getPiece(__x, __y, false) as Piece).setRemoved();
		}
		
