GRACZ_ENV=development
GRACZ_DOMAIN=localhost
GRACZ_SCHEME=http
GRACZ_BASE_URL=http://localhost/
GRACZ_SERVICE_NAME=Gracz.pl
GRACZ_CONTACT_EMAIL=kontakt@gracz.pl
GRACZ_AD_EMAIL=reklama@gracz.pl
GRACZ_MAIL_FROM=noreply@gracz.pl
GRACZ_SECURITY_ALERT_EMAIL=
GRACZ_SECURITY_MONITOR_WINDOW=10
GRACZ_PRIVATE_UPLOAD_DIR=

# Generate unique values per environment. Never copy production keys to staging/dev.
GRACZ_APP_KEY=
GRACZ_AUDIT_PEPPER=
GRACZ_PASSWORD_PEPPER=
# 32 random bytes, base64 encoded: openssl rand -base64 32
GRACZ_DATA_ENCRYPTION_KEY=

DB_HOST=127.0.0.1:3306
DB_NAME=gracz
DB_USER=gracz_app
DB_PASSWORD=
DB_PREFIX=prefix

CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

FACEBOOK_CLIENT_ID=
FACEBOOK_APP_SECRET=
SMARTFOX_ADDRESS=127.0.0.1
SMARTFOX_PORT=8888

# Legacy infrastructure administration URLs are disabled by default.
GRACZ_PHPMYADMIN_URL=
GRACZ_NAGIOS_URL=
GRACZ_WEBALIZER_URL=
GRACZ_AWSTATS_URL=

# Comma-separated terms are only auto-flagged; moderation supports user appeal and human review.
GRACZ_MODERATION_TERMS=
GRACZ_AUDIT_LOG_PATH=

# Backup/restore jobs only; do not expose these to the web process if avoidable.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
RESTORE_TEST_DB=
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
