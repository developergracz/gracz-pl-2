# Never commit real values. Use separate values for development, staging and production.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://gracz.pl

# Database: use a least-privileged application role.
DATABASE_URL=postgresql://gracz_app:CHANGE_ME@localhost:5432/gracz_dev

# Independent secrets, each random and at least 32 characters.
AUTH_SECRET=CHANGE_ME_RANDOM_64_CHARS
MESSAGE_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_CHARS
ATTACHMENT_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_CHARS
MFA_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_CHARS
AUDIT_HASH_SALT=CHANGE_ME_RANDOM_64_CHARS

# Mail provider.
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=Gracz.pl <newsletter@gracz.pl>

# Cloudflare Turnstile. Production must set both.
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
TURNSTILE_HOSTNAME=gracz.pl
TRUST_CLOUDFLARE_HEADERS=true
TRUST_PROXY_HEADERS=false
ALLOW_TURNSTILE_ON_TEST_HOSTS=false

# Optional HTTPS alert receiver. Must not contain user secrets in payloads.
SECURITY_ALERT_WEBHOOK=

# Backup encryption passphrase should be stored in the deployment secret manager.
BACKUP_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_CHARS
