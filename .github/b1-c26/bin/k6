#!/usr/bin/env bash
set -euo pipefail
: "${B1_C26_REAL_K6:?B1_C26_REAL_K6 required}"
if [[ "${1:-}" != "run" ]]; then
  exec "$B1_C26_REAL_K6" "$@"
fi
: "${WAVE_B_RUN_ID:?WAVE_B_RUN_ID required}"
report_dir="perf/k6/reports"
mkdir -p "$report_dir"
# Retain the canonical B1-C20 internal window filename/marker convention because the
# preserved telemetry collector and summary parser consume these exact names.
marker="/tmp/b1-c20-k6-start-${WAVE_B_RUN_ID}"
window_file="$report_dir/${WAVE_B_RUN_ID}-b1-c20-k6-window.json"
start_ms="$(date +%s%3N)"
start_iso="$(date -u +'%Y-%m-%dT%H:%M:%S.%3NZ')"
printf '%s|%s\n' "$start_ms" "$start_iso" > "$marker"
python3 - "$window_file" "$start_ms" "$start_iso" "${WAVE_B_WARMUP_SECONDS:-120}" "${WAVE_B_STEADY_SECONDS:-300}" "${WAVE_B_COOLDOWN_SECONDS:-120}" <<'PY'
import json,sys,datetime
p,start_ms,start_iso,warmup,steady,cooldown=sys.argv[1:]
start=int(start_ms); warmup=int(float(warmup)); steady=int(float(steady)); cooldown=int(float(cooldown))
def iso(ms): return datetime.datetime.fromtimestamp(ms/1000,datetime.timezone.utc).isoformat(timespec='milliseconds').replace('+00:00','Z')
body={
  'k6StartEpochMs':start,'k6StartIso':start_iso,
  'warmupSeconds':warmup,'steadySeconds':steady,'cooldownSeconds':cooldown,
  'steadyStartEpochMs':start+warmup*1000,'steadyStartIso':iso(start+warmup*1000),
  'steadyEndEpochMs':start+(warmup+steady)*1000,'steadyEndIso':iso(start+(warmup+steady)*1000),
  'expectedK6EndEpochMs':start+(warmup+steady+cooldown)*1000,'expectedK6EndIso':iso(start+(warmup+steady+cooldown)*1000),
}
with open(p,'w',encoding='utf-8') as f: json.dump(body,f,indent=2); f.write('\n')
PY
pids_file="/tmp/wave-b-app-pids-${WAVE_B_RUN_ID}"
if [[ ! -s "$pids_file" ]]; then
  echo "B1-C26: app PID file missing before k6 start" >&2
  exit 91
fi
while IFS= read -r pid; do
  [[ -n "$pid" ]] && kill -USR2 "$pid"
done < "$pids_file"
set +e
"$B1_C26_REAL_K6" "$@"
rc=$?
set -e
end_ms="$(date +%s%3N)"
end_iso="$(date -u +'%Y-%m-%dT%H:%M:%S.%3NZ')"
python3 - "$window_file" "$end_ms" "$end_iso" "$rc" <<'PY'
import json,sys
p,end_ms,end_iso,rc=sys.argv[1:]
with open(p,encoding='utf-8') as f: body=json.load(f)
body.update({'k6EndEpochMs':int(end_ms),'k6EndIso':end_iso,'k6Exit':int(rc),'actualDurationMs':int(end_ms)-int(body['k6StartEpochMs'])})
with open(p,'w',encoding='utf-8') as f: json.dump(body,f,indent=2); f.write('\n')
PY
exit "$rc"
